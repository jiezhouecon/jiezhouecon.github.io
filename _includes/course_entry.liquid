{% comment %}
  One course, laid out like a paper on the research page (passed as `course`).
  Left column: level badge and optional preview image. Right column: title
  linking to the course page, institution and role, term, then buttons: the
  overview behind "Abs" and one button per entry in `materials`.
{% endcomment %}
{% assign course = include.course %}
{% assign overview = course.excerpt | default: course.content | strip_html | strip %}
<div class="row">
  <div class="col col-sm-3 abbr">
    {% if course.level %}
      {% assign badge = site.data.venues[course.level] %}
      {% assign badge_color = badge.color | default: '#D6E4F0' %}
      <abbr class="badge rounded w-100" style="background-color:{{ badge_color }}">
        <div>{{ course.level }}</div>
      </abbr>
    {% endif %}
    {% if course.preview %}
      {% if course.preview contains '://' %}
        <img class="preview z-depth-1 rounded" src="{{ course.preview }}">
      {% else %}
        {% assign preview_path = course.preview | prepend: '/assets/img/course_preview/' %}
        {%
          include figure.liquid
          loading="eager"
          path=preview_path
          sizes="160px"
          class="preview z-depth-1 rounded"
          zoomable=true
          avoid_scaling=true
          alt=course.preview
        %}
      {% endif %}
    {% endif %}
  </div>

  <div id="{{ course.slug | default: course.title | slugify }}" class="col-sm-8">
    <div class="title">
      <a href="{{ course.url | relative_url }}">{{ course.title }}</a>
    </div>

    {% if course.institution or course.role %}
      <div class="author">
        {{ course.institution }}
        {%- if course.institution and course.role %}, {% endif -%}
        {{ course.role }}
      </div>
    {% endif %}

    {% if course.term %}
      <div class="periodical">{{ course.term }}</div>
    {% endif %}

    <div class="links">
      {% if overview != '' %}
        <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
      {% endif %}
      {% for item in course.materials %}
        {% if item.url contains '://' %}
          <a href="{{ item.url }}" class="btn btn-sm z-depth-0" role="button">{{ item.label }}</a>
        {% else %}
          <a href="{{ item.url | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </div>

    {% if overview != '' %}
      <!-- Hidden overview, toggled by the "Abs" button (assets/js/common.js) -->
      <div class="abstract hidden">
        <p>{{ overview }}</p>
      </div>
    {% endif %}
  </div>
</div>
