@techreport{zhou2025digitalAddiction,
  abbr={WorkInProgress},
  title={From Choice to Compulsion},
  author={Zhou, Jie},
  abstract={Motivation: Tech firms leverage big data and artificial intelligence to reshape consumer choice environments. While this information advantage can enhance product fit, it creates a tension between beneficial personalization and behavioral manipulation. 
  Method: This paper investigates this trade-off by analyzing the impact of online experimentation (A/B testing) technologies on digital addiction. We combine panel data on app-specific testing intensity with individual-level usage of a self-control app to measure digital addiction.
  Results: We find that apps employing A/B testing, particularly those using sophisticated in-house experimentation tools, are significantly more likely to be blocked by users for self-control purposes. Specifically, the adoption of online experiment technology causes users to increase their commitment (blocking) time by an average of 23.3 minutes per month.
  Finally, we calibrate a welfare model to determine the optimal Pigouvian tax on online experimentation. We estimate the social cost of addiction to be approximately $0.64 per user per month.
  },
  year={2025},
  selected={true},
  additional_info={*AI+Economics Workshop (ETHZ, 2025)*},
  preview={digitalAddiction_temporalTrend.png}
} 

@techreport{tangZhou2025dataCenter,
  abbr={WorkInProgress},
  title={Digital Sovereignty and Sustainability},
  author={Tang, Yulu and Zhou, Jie},
  abstract={Developing countries face a trilemma in building their digital economies: (1) the increasing demand for data centers in the digital era, (2) the significant costs of constructing them in warmer regions, particularly in the Global South, and (3) their environmental impact due to a substantial carbon footprint. To address these challenges, we have compiled extensive datasets tracking global internet firms' data center location decisions, user bases, and operating costs across 167 countries over the past two decades. Leveraging this data, we will develop a model to quantify the influence of critical factors -- such as market demand, operational expenses, policy changes related to data security -- on firms' data center site selection. This model enables us to conduct policy counterfactuals, identifying the most effective strategies for reducing costs and minimizing environmental impact. It also provides valuable insights for shaping policy interventions that promote the development of efficient and sustainable data centers, particularly in developing countries.},
  year={2025},
  selected={true},
  preview={pingLocation_popDist.png}
} 

@techreport{zhou2024firewall,
  abbr={WorkingPaper},
  title={Firewall for Innovation},
  author={Zhou, Jie},
  abstract={Do protectionist policies foster domestic growth and innovation in the digital economy, and if so, how? This paper investigates the impact of the Great Firewall (GFW) in China – the world's largest system of internet regulation – on the development of domestic mobile apps. By blocking foreign apps at times determined mostly by political considerations, the GFW prompted a 30% user base expansion for Chinese substitute apps (identified through their baseline text descriptions). Monthly data on these apps’ underlying technologies, extracted from their compiled source code, reveal that Chinese substitute apps accelerated their innovation efforts, with in-house development increasing by 14% two years after the blockage. This technological progress spilled over broadly post-blockage, as both domestic and foreign apps adopted more Chinese technologies. I further show that increased access to data was one important driver. Chinese apps requested more types of sensitive data and were more likely to share user data access with outside firms after their foreign substitutes were blocked. These increased types of user data generate innovation; quasi-random variation in the introduction of new data access raises in-house technology development. Finally, using data-sharing networks between app developers, I show that in-house development also increased at the firms that user data was shared with. In summary, protectionist policies brought about through China's GFW boosted its app industry, potentially contributing to China's leadership role in this fast-growing industry.},
  year={2024},
  selected={false},
  pdf={}
} 

@inproceedings{cheng2023adaptive,
  title={An Adaptive Randomization Algorithm for Online Controlled Experiments},
  author={Cheng, Daxi and Xie, Huizhi and Jin, Yaran and Zhang, Lu and Zhou, Jie},
  abstract={Internet companies extensively utilize hash-based bucket systems for scalable A/B testing, but this method suffers from "carryover effects" where previous experiments influence the outcomes of subsequent ones. While a two-level randomization design can mitigate these effects by introducing a new random factor for treatment assignment, it does not guarantee improved variance or traffic savings. This paper investigates the optimal conditions for transitioning from a one-level to a two-level design by analyzing 2,685 experiments to confirm the prevalence of carryover effects and examining the theoretical ratio of variances, known as the "design effect." The study concludes that the two-level design is more efficient when the intraclass correlation coefficient exceeds zero, with the marginal benefit of this coefficient positively correlated to the mean and variance of the bucket sizes.},
  booktitle={Conference on Digital Experimentation (CODE)},
  selected={false},
  year={2023}
}

@techreport{acemoglu2021political,
  abbr={WorkingPaper},
  title={Political Pressure and the Direction of Research},
  author={Acemoglu, Daron and Yang, David Y and Zhou, Jie},
  abstract={Freedom of inquiry is often viewed as the foundation of innovation. Does political pressure impact the direction and quality of innovation in general, and academic research in particular? To answer this question, we collect comprehensive data on the scientific publications of researchers in the leading 109 Chinese universities and the leadership changes in these universities. We use NLP methods to measure the similarity between faculty members’ and their leaders’ research portfolios. We find that immediately after—and not before—the leaders take office, faculty members begin to shift their research direction towards that of their leaders. Such shifts are stronger among leaders with more political power and in disciplines that have been historically more heavily targeted for academic persecution. We also document significant costs of leaders’ influence on research quality. Below-median productivity leaders lead to even greater increases in similarity, and switches from above-median to below-median leaders is associated with sizable declines in citations. We show that these results are driven by citations to papers that are most similar to new leaders. Taken together, our results suggest that political pressure impacts the direction of academic research at the expense of research quality.},
  year={2021},
  selected={true},
  pdf={https://www.dropbox.com/scl/fi/dvg18640fa0exryv13heh/Bureaucracy_and_Innovation.pdf?rlkey=2oak4021834fuynu9nus0vj9g&dl=1},
  additional_info={*Seminar on Using Text as Data in Policy Analysis (Stanford Hoover Institute, 2021); Summer Institute on Science of Science Funding (NBER, 2021)*},
  dimensions={true},
  google_scholar_id={ZbF-3bYAAAAJ:d1gkVwhDpl0C},
  preview={baseline_tfidf_max_l4.png}
} 

@inproceedings{zhang2019information,
  abbr={Conference},
  title={Information Extraction from Text Regions with Complex Tabular Structure},
  author={Zhang, Kaixuan and Shen, Shannon Zejiang and Zhou, Jie and Dell, Melissa},
  booktitle={Workshop on Document Intelligence (DI 2019) at NeurIPS 2019},
  abstract={Recent innovations have improved layout analysis of document images, significantly improving our ability to identify text and non-text regions. However, extracting information from within text regions remains quite challenging because the text region may have a complex structure. In this paper, we present a new dataset with complex tabular structure, and propose new methods to robustly retrieve information from the complex text region.},
  year={2019},
  pdf={https://openreview.net/pdf?id=Hkx0zpccLr},
  google_scholar_id={ZbF-3bYAAAAJ:u5HHmVD_uO8C}
}

